---
// Bandeau de signature Triskell Studio — discret mais visible, en bas de chaque page.
---

<section class="tk-signoff" aria-label="Édité par Triskell Studio">
  <div class="container tk-grid">
    <div class="tk-left">
      <span class="tk-eyebrow">Site édité par</span>
      <a href="https://triskell-studio.fr" target="_blank" rel="noopener noreferrer" class="tk-brand">
        <img class="tk-mark" src="/brand/triskell-mark.svg" alt="" width="40" height="40" />
        <span class="tk-name">Triskell Studio</span>
      </a>
      <p class="tk-pitch">
        Studio digital indépendant. On code, on designe et on déploie des sites,
        des outils et des marques sur-mesure pour combattants, créateurs et entrepreneurs.
      </p>
    </div>
    <div class="tk-right">
      <span class="tk-eyebrow">Autres projets</span>
      <ul class="tk-projects">
        <li><a href="https://rankus-studio.fr" target="_blank" rel="noopener noreferrer">RankUs Studio<span>rankus-studio.fr</span></a></li>
        <li><a href="https://studio-wow.fr" target="_blank" rel="noopener noreferrer">Studio Wow<span>studio-wow.fr</span></a></li>
      </ul>
      <a href="https://triskell-studio.fr" target="_blank" rel="noopener noreferrer" class="tk-cta">
        Découvrir Triskell <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .tk-signoff {
    background:
      linear-gradient(135deg, rgba(220, 38, 38, 0.04), transparent 60%),
      var(--bg-elevated);
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 3rem;
  }
  .tk-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 800px) { .tk-grid { grid-template-columns: 1fr; gap: 2rem; } }
  .tk-eyebrow {
    display: block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.75rem;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }
  .tk-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .tk-mark {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }
  .tk-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tk-brand:hover .tk-name { color: var(--accent); }
  .tk-pitch {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 40rem;
  }

  .tk-projects {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tk-projects a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.6rem 0.9rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 600;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .tk-projects a:hover { border-color: var(--accent); color: var(--accent); }
  .tk-projects a span {
    color: var(--text-dim);
    font-weight: 400;
    font-size: 0.82rem;
    margin-left: 1rem;
  }
  .tk-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.92rem;
  }
  .tk-cta:hover { letter-spacing: 0.08em; }
</style>
