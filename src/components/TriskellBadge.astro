---
// Badge flottant Triskell Studio — bottom-right, dismissable, persistant en localStorage.
---

<a href="https://triskell-studio.fr" target="_blank" rel="noopener noreferrer" class="tk-badge" id="tk-badge" data-tk-badge>
  <img class="tk-badge-mark" src="/brand/triskell-mark.svg" alt="" width="22" height="22" />
  <span class="tk-badge-text">
    <span class="tk-badge-l1">Site par</span>
    <span class="tk-badge-l2">Triskell Studio</span>
  </span>
</a>
<button class="tk-badge-close" type="button" aria-label="Masquer la signature Triskell" data-tk-close>×</button>

<style>
  .tk-badge {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem 0.55rem 0.7rem;
    background: rgba(10, 10, 10, 0.92);
    color: #ffffff;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transform: translateY(0);
    transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
    border: 1px solid rgba(255,255,255,0.1);
    font-family: var(--font-body);
  }
  .tk-badge.hidden { opacity: 0; pointer-events: none; transform: translateY(20px); }
  .tk-badge:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(0,0,0,0.35); color: #ffffff; }
  .tk-badge-mark {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }
  .tk-badge-text { display: inline-flex; flex-direction: column; line-height: 1.1; }
  .tk-badge-l1 {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.6);
  }
  .tk-badge-l2 {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: #ffffff;
  }
  .tk-badge-close {
    position: fixed;
    right: 0.4rem;
    bottom: 2.65rem;
    z-index: 41;
    width: 18px;
    height: 18px;
    background: rgba(10,10,10,0.92);
    color: white;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1;
    padding: 0;
    transition: opacity 0.2s ease;
  }
  .tk-badge-close.hidden { opacity: 0; pointer-events: none; }
  @media (max-width: 600px) {
    .tk-badge { right: 0.6rem; bottom: 0.6rem; }
    .tk-badge-close { right: 0.2rem; bottom: 2.2rem; }
  }
</style>

<script is:inline>
  (function() {
    const KEY = 'tk_badge_dismissed';
    const badge = document.querySelector('[data-tk-badge]');
    const closeBtn = document.querySelector('[data-tk-close]');
    if (!badge || !closeBtn) return;
    try {
      if (localStorage.getItem(KEY) === '1') {
        badge.classList.add('hidden');
        closeBtn.classList.add('hidden');
        return;
      }
    } catch (e) {}
    closeBtn.addEventListener('click', () => {
      badge.classList.add('hidden');
      closeBtn.classList.add('hidden');
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });
  })();
</script>
