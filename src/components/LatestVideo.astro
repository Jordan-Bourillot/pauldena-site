---
const YT_CHANNEL_ID = "UCJMvCyy_DqvyedtQOJm4tvQ";
const RSS_URL = `https://www.youtube.com/feeds/videos.xml?channel_id=${YT_CHANNEL_ID}`;

const decode = (s: string) =>
  s.replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#39;/g, "'");

async function fetchLatest() {
  try {
    const res = await fetch(RSS_URL, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!res.ok) return null;
    const xml = await res.text();
    const entry = xml.split("<entry>")[1] ?? "";
    const id = entry.match(/<yt:videoId>([^<]+)<\/yt:videoId>/)?.[1];
    const title = entry.match(/<title>([^<]+)<\/title>/)?.[1];
    const published = entry.match(/<published>([^<]+)<\/published>/)?.[1];
    if (!id || !title) return null;
    return { id, title: decode(title), published };
  } catch { return null; }
}

const v = await fetchLatest() ?? {
  id: "oYPRxi5UZn0",
  title: "Tibo Inshape me défie en boxe anglaise",
  published: "2026-04-05",
};
const dateStr = v.published
  ? new Date(v.published).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })
  : "";
---

<div class="latest-video" data-lv data-fallback-id={v.id} data-fallback-title={v.title} data-fallback-date={dateStr}>
  <div class="lv-thumb-wrap">
    <button class="lv-play" type="button" aria-label="Lancer la vidéo" data-id={v.id}>
      <img class="lv-thumb" src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt={v.title} loading="lazy" />
      <span class="lv-play-icon" aria-hidden="true">▶</span>
    </button>
  </div>
  <div class="lv-meta">
    <span class="lv-badge">Dernière vidéo</span>
    <h3 class="lv-title">{v.title}</h3>
    <time class="lv-date">{dateStr}</time>
    <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="lv-link">
      Ouvrir sur YouTube ↗
    </a>
  </div>
</div>

<style>
  .latest-video {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .latest-video::before {
    content: "";
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 4px;
    background: var(--accent);
    z-index: 3;
  }
  .latest-video:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }
  @media (max-width: 800px) { .latest-video { grid-template-columns: 1fr; } }
  .lv-thumb-wrap { position: relative; background: #000; }
  .lv-play {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: none;
    background: #000;
    cursor: pointer;
    overflow: hidden;
  }
  .lv-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease, opacity 0.2s ease;
    opacity: 0.92;
  }
  .lv-play:hover .lv-thumb { transform: scale(1.04); opacity: 1; }
  .lv-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
    text-shadow: 0 4px 18px rgba(0,0,0,0.6);
    pointer-events: none;
  }
  .lv-meta {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    justify-content: center;
  }
  .lv-badge {
    display: inline-block;
    width: fit-content;
    padding: 0.25rem 0.7rem;
    background: rgba(220, 38, 38, 0.14);
    color: var(--accent);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lv-meta h3 { font-size: clamp(1.3rem, 2.3vw, 1.85rem); line-height: 1.15; }
  .lv-meta time { color: var(--text-dim); font-size: 0.9rem; }
  .lv-link { color: var(--accent); font-weight: 600; font-size: 0.95rem; margin-top: 0.5rem; }
</style>

<script is:inline>
  // Player embed on click
  (function() {
    document.addEventListener('click', (e) => {
      const btn = e.target.closest && e.target.closest('.lv-play');
      if (!btn) return;
      const id = btn.dataset.id;
      if (!id) return;
      const wrap = btn.parentElement;
      wrap.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" style="width:100%;aspect-ratio:16/9;border:0;display:block;" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe>`;
    });
  })();

  // Auto-refresh client-side : appelle l'edge function /api/latest-video à chaque chargement
  // pour avoir la dernière vidéo même sans rebuild.
  (function() {
    async function refresh() {
      const root = document.querySelector('[data-lv]');
      if (!root) return;
      try {
        const r = await fetch('/api/latest-video', { cache: 'no-store' });
        if (!r.ok) return;
        const data = await r.json();
        const latest = data.items && data.items[0];
        if (!latest || !latest.id) return;
        // Si l'id sur la page est déjà la dernière vidéo, rien à faire
        const btn = root.querySelector('.lv-play');
        if (!btn || btn.dataset.id === latest.id) return;
        // Sinon, on met à jour le DOM
        btn.dataset.id = latest.id;
        const img = btn.querySelector('.lv-thumb');
        if (img) { img.src = latest.thumbnail; img.alt = latest.title; }
        const t = root.querySelector('.lv-title');
        if (t) t.textContent = latest.title;
        const time = root.querySelector('.lv-date');
        if (time && latest.published) {
          time.textContent = new Date(latest.published).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        }
        const link = root.querySelector('.lv-link');
        if (link) link.href = `https://www.youtube.com/watch?v=${latest.id}`;
      } catch (e) { /* silencieux */ }
    }
    refresh();
    document.addEventListener('astro:page-load', refresh);
  })();
</script>
