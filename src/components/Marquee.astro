---
interface Props {
  items: string[];
  speed?: number;
}
const { items, speed = 40 } = Astro.props;
const dup = [...items, ...items];
---

<div class="marquee" aria-hidden="true" style={`--marquee-speed:${speed}s`}>
  <div class="marquee-track">
    {dup.map((t) => (
      <span class="marquee-item"><span class="marquee-dot">●</span>{t}</span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.8rem 0;
    background: var(--bg-elevated);
    user-select: none;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 3.5rem;
    width: max-content;
    animation: marquee-scroll var(--marquee-speed, 40s) linear infinite;
  }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.08em;
    color: var(--text);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marquee-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    background: var(--accent);
    border-radius: 50%;
    font-size: 0;
    box-shadow: 0 0 12px rgba(220, 38, 38, 0.5);
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
