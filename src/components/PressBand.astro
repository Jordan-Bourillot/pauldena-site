---
const items = [
  { name: "HEXAGONE MMA",   caption: "Promotion officielle", style: "bebas-tight" },
  { name: "RMC Sport",      caption: "Couverture presse",    style: "italic-bold" },
  { name: "Karate Bushido", caption: "Magazine combat",      style: "serif-cap" },
  { name: "IbraTV / YFC",   caption: "Émergence",            style: "stencil" },
  { name: "IMMAF Europe",   caption: "Bronze 2024",          style: "outline" },
  { name: "UFC Paris",      caption: "Commentaire invité",   style: "ultra-bold" },
];
---

<section class="press-band">
  <div class="container">
    <span class="press-eyebrow">Vu chez · cités par</span>
    <ul class="press-list">
      {items.map((p) => (
        <li class="press-item">
          <span class={`press-name press-${p.style}`}>{p.name}</span>
          <span class="press-caption">{p.caption}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .press-band {
    padding: 4rem 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .press-band::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
  }
  .press-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.32em;
    font-size: 0.82rem;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
  }
  .press-eyebrow::before, .press-eyebrow::after {
    content: "";
    flex: 0 0 30px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .press-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.75rem 1.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1100px) {
    .press-list { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .press-list { grid-template-columns: repeat(2, 1fr); }
  }
  .press-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    opacity: 0.72;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .press-item:hover { opacity: 1; transform: translateY(-2px); }
  .press-name {
    color: var(--text);
    line-height: 1;
  }
  .press-caption {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Styles typographiques distinctifs pour évoquer chaque média */
  .press-bebas-tight {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .press-italic-bold {
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .press-serif-cap {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .press-stencil {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--text);
    padding-bottom: 0.15rem;
  }
  .press-outline {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    -webkit-text-stroke: 1px var(--text);
    color: transparent;
  }
  .press-ultra-bold {
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
</style>
