---
interface Props {
  title: string;
  url: string;
  thumbnail?: string;
  source: "YouTube" | "TikTok" | "Instagram";
  date?: string;
}

const { title, url, thumbnail, source, date } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="video-card">
  <div class="thumb-wrap">
    {thumbnail ? (
      <img src={thumbnail} alt={title} loading="lazy" />
    ) : (
      <div class="thumb-placeholder">
        <span>{source}</span>
      </div>
    )}
    <span class="source-badge">{source}</span>
    <span class="play">▶</span>
  </div>
  <div class="meta">
    <h3 class="title">{title}</h3>
    {date && <time>{date}</time>}
  </div>
</a>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
    color: var(--text);
  }
  .video-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    color: var(--text);
  }
  .thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
  }
  .source-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.2rem 0.6rem;
    background: rgba(10, 10, 10, 0.85);
    border-radius: 4px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: white;
    opacity: 0;
    background: rgba(0, 0, 0, 0.4);
    transition: opacity 0.15s ease;
  }
  .video-card:hover .play {
    opacity: 1;
  }
  .meta {
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
  }
  time {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
</style>
