---
import { socials } from "../data/profile";

interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "md" } = Astro.props;

const items = [
  { key: "instagram", label: "Instagram", url: socials.instagram.url, handle: "@" + socials.instagram.handle },
  { key: "tiktok", label: "TikTok", url: socials.tiktok.url, handle: "@" + socials.tiktok.handle },
  { key: "youtube", label: "YouTube", url: socials.youtube.url, handle: "@" + socials.youtube.handle },
  { key: "twitter", label: "X", url: socials.twitter.url, handle: "@" + socials.twitter.handle },
];
---

<ul class:list={["social-bar", `size-${size}`]}>
  {
    items.map((item) => (
      <li>
        <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
          <span class="label">{item.label}</span>
          <span class="handle">{item.handle}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-bar {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .social-bar a {
    display: inline-flex;
    flex-direction: column;
    padding: 0.6rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .social-bar a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: var(--text);
  }
  .label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .handle {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .size-lg a {
    padding: 1rem 1.5rem;
  }
  .size-lg .label {
    font-size: 1rem;
  }
  .size-lg .handle {
    font-size: 1.1rem;
  }
  .size-sm a {
    padding: 0.4rem 0.8rem;
  }
  .size-sm .handle {
    display: none;
  }
</style>
