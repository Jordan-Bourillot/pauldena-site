---
interface Props {
  to: string;            // ISO date
  label?: string;
  compact?: boolean;
}
const { to, label = "Avant le combat", compact = false } = Astro.props;
---

<div class:list={["countdown", { compact }]} data-to={to}>
  <span class="cd-label">{label}</span>
  <div class="cd-row">
    <span class="cd-unit"><strong class="cd-d">—</strong><em>jours</em></span>
    <span class="cd-sep" aria-hidden="true">:</span>
    <span class="cd-unit"><strong class="cd-h">—</strong><em>h</em></span>
    <span class="cd-sep" aria-hidden="true">:</span>
    <span class="cd-unit"><strong class="cd-m">—</strong><em>min</em></span>
    <span class="cd-sep" aria-hidden="true">:</span>
    <span class="cd-unit"><strong class="cd-s">—</strong><em>sec</em></span>
  </div>
</div>

<style>
  .countdown {
    display: inline-flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cd-label {
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .cd-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .cd-unit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.5rem;
  }
  .cd-unit strong {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    color: var(--text);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .cd-unit em {
    font-style: normal;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-top: 0.4rem;
  }
  .cd-sep {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
    padding-bottom: 1.6rem;
  }
  .compact .cd-unit strong { font-size: 1.6rem; }
  .compact .cd-sep { font-size: 1.2rem; padding-bottom: 0.6rem; }
  .compact .cd-unit { min-width: 3rem; }
</style>

<script is:inline>
  (function() {
    if (window.__countdownInit) return;
    window.__countdownInit = true;
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick(el) {
      const target = new Date(el.dataset.to).getTime();
      const now = Date.now();
      let diff = Math.max(0, target - now);
      const d = Math.floor(diff / 86400000); diff -= d * 86400000;
      const h = Math.floor(diff / 3600000);  diff -= h * 3600000;
      const m = Math.floor(diff / 60000);    diff -= m * 60000;
      const s = Math.floor(diff / 1000);
      el.querySelector('.cd-d').textContent = d;
      el.querySelector('.cd-h').textContent = pad(h);
      el.querySelector('.cd-m').textContent = pad(m);
      el.querySelector('.cd-s').textContent = pad(s);
    }
    function start() {
      document.querySelectorAll('.countdown').forEach((el) => {
        tick(el);
        setInterval(() => tick(el), 1000);
      });
    }
    start();
    document.addEventListener('astro:page-load', start);
  })();
</script>
