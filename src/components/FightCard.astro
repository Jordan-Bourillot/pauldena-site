---
import type { Fight } from "../data/profile";

interface Props {
  fight: Fight;
}

const { fight } = Astro.props;

const resultLabel = { W: "Victoire", L: "Défaite", D: "Nul", NC: "No Contest" }[fight.result];
const resultClass = `result-${fight.result.toLowerCase()}`;
---

<article class="fight-card">
  <div class={`result-badge ${resultClass}`}>
    <span class="result-letter">{fight.result}</span>
    <span class="result-label">{resultLabel}</span>
  </div>
  <div class="fight-body">
    <div class="fight-event">
      {fight.event}{fight.venue ? ` — ${fight.venue}` : ""}
      {fight.isAmateur && <span class="tag-amateur">Amateur</span>}
    </div>
    <div class="fight-vs">
      <span class="vs">vs</span>
      <span class="opponent">{fight.opponent}</span>
    </div>
    <div class="fight-meta">
      <time>{new Date(fight.date).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}</time>
      {fight.method && (
        <span class="method">
          {fight.method}{fight.round ? ` · R${fight.round}` : ""}{fight.time ? ` · ${fight.time}` : ""}
        </span>
      )}
    </div>
    {fight.note && <p class="fight-note">{fight.note}</p>}
  </div>
  {fight.videoUrl && (
    <a href={fight.videoUrl} target="_blank" rel="noopener noreferrer" class="fight-watch">
      Voir le combat ↗
    </a>
  )}
</article>

<style>
  .fight-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }
  .fight-card:hover {
    border-color: var(--accent);
  }
  .result-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 64px;
    padding: 0.5rem 0;
    border-radius: var(--radius);
    font-weight: 700;
  }
  .result-w { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
  .result-l { background: rgba(220, 38, 38, 0.15); color: #f87171; }
  .result-d, .result-nc { background: rgba(163, 163, 163, 0.15); color: #d4d4d4; }
  .result-letter {
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
  }
  .result-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.85;
  }
  .fight-event {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 0.25rem;
  }
  .fight-vs {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .vs {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .opponent {
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-transform: uppercase;
  }
  .fight-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .method::before {
    content: "·";
    margin-right: 0.5rem;
  }
  .fight-watch {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    white-space: nowrap;
  }
  .tag-amateur {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    background: rgba(234, 179, 8, 0.15);
    color: #eab308;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .fight-note {
    margin-top: 0.5rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-style: italic;
    max-width: 40rem;
  }
  @media (max-width: 600px) {
    .fight-card {
      grid-template-columns: auto 1fr;
    }
    .fight-watch {
      grid-column: 1 / -1;
      text-align: right;
    }
  }
</style>
