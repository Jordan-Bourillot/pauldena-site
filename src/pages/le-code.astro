---
import Base from "../layouts/Base.astro";
import Reveal from "../components/Reveal.astro";
import { profile } from "../data/profile";

const values = [
  {
    num: "01",
    title: "Pas de raccourcis",
    body: "Chaque combat se gagne au camp d'avant. Pas de routine bâclée, pas de récup' sautée. Le travail invisible est ce qui rend le travail visible spectaculaire.",
    photo: "/photos/training-bag.jpg",
    position: "center 30%",
  },
  {
    num: "02",
    title: "Pas d'excuses",
    body: "Un blessé. Un défaite. Un mauvais round. Les explications n'effacent pas le résultat. La seule question qui compte : qu'est-ce que je fais demain.",
    photo: "/photos/trail-run.jpg",
    position: "center 60%",
  },
  {
    num: "03",
    title: "Pas de filtre",
    body: "Les vlogs montrent tout. Les KO ET les doutes. Les victoires ET les nuits sans sommeil. La transparence n'est pas un risque : c'est ce qui construit la vraie confiance.",
    photo: "/photos/hero-corridor.jpg",
    position: "center 20%",
  },
  {
    num: "04",
    title: "Mentalité d'entrepreneur",
    body: "Un athlète, c'est aussi une entreprise. Sponsors, médias, fans, équipe : ça se gère comme un projet. Avec rigueur, vision et discipline.",
    photo: "/photos/paul-paris.jpg",
    position: "center 30%",
  },
  {
    num: "05",
    title: "Le talent ne suffit pas",
    body: "Personne ne devient champion par accident. Le talent met sur la grille. Le travail décide de la place sur le podium.",
    photo: "/photos/hero-flag.jpg",
    position: "center 15%",
  },
];
---

<Base
  title={`Le Code — ${profile.nickname}`}
  description="Le code de Paul Dena : cinq valeurs qui structurent son approche du combat, du contenu et du quotidien."
>
  <section class="hero-code">
    <div class="hero-code-bg" style="background-image:url('/photos/hero-cage.jpg')" aria-hidden="true"></div>
    <div class="hero-code-veil" aria-hidden="true"></div>
    <div class="container hero-code-inner">
      <Reveal>
        <span class="eyebrow">Le Code</span>
        <h1>Cinq lignes.<br /><span class="accent">Aucune négociable.</span></h1>
        <p class="lead">
          Les règles que Paul Dena s'impose dans chaque camp, chaque vlog, chaque
          interview. Pas un slogan marketing — un cadre de travail.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="section values-section">
    <div class="container">
      <ol class="values">
        {values.map((v, i) => (
          <Reveal as="li" class={`value ${i % 2 === 0 ? "value-left" : "value-right"}`} delay={i * 60}>
            <div class="value-photo" style={`background-image:url('${v.photo}'); background-position:${v.position}`} aria-hidden="true">
              <span class="value-num-overlay">{v.num}</span>
            </div>
            <div class="value-body">
              <span class="value-num">{v.num}</span>
              <h2>{v.title}</h2>
              <p>{v.body}</p>
            </div>
          </Reveal>
        ))}
      </ol>
    </div>
  </section>

  <section class="section closing">
    <div class="container">
      <Reveal>
        <p class="closing-line">Le travail parle plus fort que le talent.</p>
        <p class="closing-sub">C'est tout.</p>
        <div class="closing-cta">
          <a href="/combats" class="btn">Voir les combats</a>
          <a href="/sponsors" class="btn btn-ghost">Travailler ensemble</a>
        </div>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* HERO BANNER */
  .hero-code {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #ffffff;
  }
  .hero-code-bg {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover;
    background-position: center 30%;
    filter: grayscale(40%) brightness(0.55);
    animation: heroCodePan 22s ease-in-out infinite alternate;
  }
  @keyframes heroCodePan {
    from { transform: scale(1.04); }
    to   { transform: scale(1.12); }
  }
  .hero-code-veil {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(10,10,10,0.4) 0%, rgba(10,10,10,0.75) 80%, var(--bg) 100%),
      radial-gradient(ellipse at bottom left, rgba(220, 38, 38, 0.3), transparent 60%);
  }
  .hero-code-inner { position: relative; z-index: 2; padding-top: 5rem; padding-bottom: 5rem; max-width: 900px; }
  .hero-code .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.25em;
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }
  .hero-code h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.95;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }
  .hero-code .accent { color: var(--accent); }
  .hero-code .lead {
    color: rgba(255,255,255,0.85);
    font-size: 1.2rem;
    max-width: 42rem;
    line-height: 1.6;
  }

  /* VALUES — alternance gauche/droite */
  .values-section { padding-top: 4rem; }
  .values { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2.5rem; }
  .value {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .value.value-right { direction: rtl; }
  .value.value-right > * { direction: ltr; }
  @media (max-width: 800px) {
    .value, .value.value-right { grid-template-columns: 1fr; direction: ltr; gap: 1.25rem; }
  }
  .value-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .value-photo::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.4));
  }
  .value-num-overlay {
    position: absolute;
    bottom: -0.4rem;
    right: 0.6rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(7rem, 16vw, 12rem);
    color: rgba(255,255,255,0.85);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .value-body { padding: 0 0.5rem; }
  .value-num {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.05rem;
    letter-spacing: 0.22em;
    margin-bottom: 0.6rem;
  }
  .value h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .value p {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 36rem;
  }

  /* CLOSING */
  .closing {
    text-align: center;
    background:
      radial-gradient(ellipse at center, rgba(220, 38, 38, 0.12), transparent 70%),
      var(--bg-elevated);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .closing-line {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.5vw, 5rem);
    color: var(--text);
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .closing-sub {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }
  .closing-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
