---
import Base from "../layouts/Base.astro";
---

<Base title="Page introuvable — Paul Dena">
  <section class="page-404">
    <div class="container">
      <span class="four-mark">404</span>
      <h1>Touché à côté.</h1>
      <p>Cette page n'existe pas, ou a été déplacée. Pas de TKO, juste un mauvais round.</p>
      <div class="cta">
        <a href="/" class="btn">Retour à l'accueil</a>
        <a href="/combats" class="btn btn-ghost">Voir les combats</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-404 {
    min-height: 70vh;
    display: flex;
    align-items: center;
    text-align: center;
    background:
      radial-gradient(ellipse at center, rgba(220, 38, 38, 0.10), transparent 70%),
      var(--bg);
    padding: 6rem 0;
  }
  .four-mark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(7rem, 18vw, 14rem);
    color: var(--accent);
    line-height: 1;
    letter-spacing: 0;
    margin-bottom: 1rem;
  }
  .page-404 h1 { margin-bottom: 1rem; }
  .page-404 p { color: var(--text-dim); margin-bottom: 2.5rem; max-width: 38rem; margin-left: auto; margin-right: auto; }
  .cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
