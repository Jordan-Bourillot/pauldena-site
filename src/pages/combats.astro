---
import Base from "../layouts/Base.astro";
import FightCard from "../components/FightCard.astro";
import Reveal from "../components/Reveal.astro";
import CountUp from "../components/CountUp.astro";
import { profile, fights, upcomingFights } from "../data/profile";

const proFights = fights.filter((f) => !f.isAmateur);
const wins = proFights.filter((f) => f.result === "W").length;
const losses = proFights.filter((f) => f.result === "L").length;
const draws = proFights.filter((f) => f.result === "D" || f.result === "NC").length;
const finishes = proFights.filter((f) => f.method?.includes("KO") || f.method?.includes("TKO") || f.method?.includes("Sub")).length;
const finishRate = proFights.length ? Math.round((finishes / proFights.length) * 100) : 0;
const nextFight = upcomingFights[0];
---

<Base
  title={`Combats — ${profile.nickname}`}
  description="Palmarès complet de Paul Dena : 3-0-0 en pro, 100% de finish. Combats Hexagone MMA, record du KO le plus rapide en 5 secondes, prochain combat au LDLC Arena de Lyon."
>
  <section class="page-header section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Palmarès</span>
        <h1>Record professionnel</h1>
        <p class="lead">Tous les combats officiels, du débuts pro à aujourd'hui.</p>
      </Reveal>
      <Reveal class="record" delay={120}>
        <div class="record-stat win">
          <span class="big"><CountUp to={wins} /></span><span class="lbl">Victoires</span>
        </div>
        <div class="record-stat loss">
          <span class="big"><CountUp to={losses} /></span><span class="lbl">Défaites</span>
        </div>
        <div class="record-stat draw">
          <span class="big"><CountUp to={draws} /></span><span class="lbl">Nuls / NC</span>
        </div>
        <div class="record-stat finish">
          <span class="big"><CountUp to={finishRate} suffix="%" /></span><span class="lbl">Finish</span>
        </div>
      </Reveal>
    </div>
  </section>

  {nextFight && (
    <section class="section next-section">
      <div class="container">
        <Reveal>
          <div class="next-card">
            <div>
              <span class="eyebrow accent">À venir</span>
              <h2>{nextFight.event}</h2>
              <p class="next-meta">
                {new Date(nextFight.date).toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" })}
                {" · "}{nextFight.venue}
              </p>
              <p class="next-vs">vs <strong>{nextFight.opponent}</strong></p>
            </div>
          </div>
        </Reveal>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <Reveal><h2>Liste des combats</h2></Reveal>
      {fights.length === 0 ? (
        <p class="empty">Palmarès à compléter.</p>
      ) : (
        <div class="fights-list">
          {fights.map((f, i) => (
            <Reveal delay={i * 60}>
              <FightCard fight={f} />
            </Reveal>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .page-header { padding-top: 4rem; padding-bottom: 3rem; }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .lead { color: var(--text-dim); margin-top: 1rem; font-size: 1.15rem; max-width: 40rem; }
  .record {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .record-stat {
    padding: 1.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .record-stat:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .record-stat .big {
    display: block;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
  }
  .record-stat .lbl {
    display: block;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.82rem;
    margin-top: 0.5rem;
  }
  .record-stat.win .big { color: #16a34a; }
  :root[data-theme="dark"] .record-stat.win .big { color: #4ade80; }
  .record-stat.loss .big { color: #dc2626; }
  :root[data-theme="dark"] .record-stat.loss .big { color: #f87171; }
  .record-stat.draw .big { color: var(--text-dim); }
  .record-stat.finish .big { color: var(--accent); }

  .next-section { padding-top: 0; padding-bottom: 3rem; }
  .next-card {
    padding: 2rem 2.25rem;
    background:
      linear-gradient(120deg, rgba(220, 38, 38, 0.16), transparent 60%),
      var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .next-card h2 { margin-bottom: 0.4rem; font-size: clamp(1.4rem, 2.4vw, 2rem); }
  .next-meta { color: var(--text-dim); margin-bottom: 0.75rem; }
  .next-vs { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 0.04em; }
  .next-vs strong { color: var(--text); }
  .eyebrow.accent { color: var(--accent); }

  .fights-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
  .empty {
    margin-top: 2rem;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-dim);
    text-align: center;
  }
</style>
