---
import Base from "../layouts/Base.astro";
import Reveal from "../components/Reveal.astro";
import CountUp from "../components/CountUp.astro";
import Quote from "../components/Quote.astro";
import { profile } from "../data/profile";

// Sources : RMC Sport (audit début 2025) + relevés profils publics, mai 2026.
const audience = [
  { value: 427, suffix: "K", label: "Followers Instagram", source: "@pauldenisnavero" },
  { value: 217, suffix: "K", label: "Abonnés YouTube", source: "@pauldenisnavero" },
  { value: 170, suffix: "K", label: "Abonnés TikTok", source: "@pauldenisnavero" },
  { value: 814, suffix: "K", label: "Communauté cumulée", source: "IG + YT + TT" },
];

const formats = [
  {
    icon: "shirt",
    title: "Logo sur tenue de combat",
    body: "Visibilité maximale les soirs de gala : entrée, combat, interviews, photos officielles. Audience TV + replay + presse spécialisée.",
  },
  {
    icon: "video",
    title: "Placement produit",
    body: "Intégration naturelle dans un vlog YouTube ou une vidéo TikTok. Mécanique testée, taux d'engagement élevé.",
  },
  {
    icon: "star",
    title: "Ambassadeur sur la durée",
    body: "Engagement annuel : capsules dédiées, présence événementielle, prise de parole, ambassadorat sur la durée.",
  },
  {
    icon: "link",
    title: "Affiliation & codes",
    body: "Codes promo / liens trackés pour les marques alignées avec l'univers MMA, performance et entrepreneuriat.",
  },
];

const audienceUpdatedAt = "Mai 2026";
---

<Base
  title={`Sponsors — ${profile.nickname}`}
  description="Travailler avec Paul Dena : audience de 800 000 abonnés cumulés, formats de partenariat (tenue de combat, placement produit, ambassadorat), media kit sur demande."
>
  <section class="page-header section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Sponsoring</span>
        <h1>Travailler avec {profile.nickname}</h1>
        <p class="lead">
          Une audience jeune, majoritairement masculine 18-34, passionnée de sport, de
          dépassement et d'entrepreneuriat. Si ces valeurs résonnent avec ta marque, parlons-en.
        </p>
        <div class="cta-row">
          <a href="/contact" class="btn">Demander le media kit</a>
          <a href="/contact" class="btn btn-ghost">Parler à l'équipe</a>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section audience-section">
    <div class="container">
      <Reveal><h2>Audience</h2></Reveal>
      <div class="audience-grid">
        {audience.map((a, i) => (
          <Reveal class="audience-card" delay={i * 70}>
            <span class="audience-value"><CountUp to={a.value} suffix={a.suffix} /></span>
            <span class="audience-label">{a.label}</span>
            <span class="audience-source">{a.source}</span>
          </Reveal>
        ))}
      </div>
      <p class="footnote">
        Sources : profils publics @pauldenisnavero — dernier relevé {audienceUpdatedAt}.
        Référence presse : RMC Sport (audit début 2025).
        Chiffres détaillés (engagement, démographie, watch time, top pays) disponibles sur demande.
      </p>
    </div>
  </section>

  <section class="section quote-section">
    <div class="container">
      <Reveal>
        <Quote
          text="Une communauté de plus de 800 000 personnes, construite combat après combat, vlog après vlog. Pas du marketing : de la transparence."
          author="Triskell Studio"
          source="Note d'opportunité, 2026"
        />
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Formats</span>
        <h2>Comment on collabore</h2>
      </Reveal>
      <div class="formats-grid">
        {formats.map((f, i) => (
          <Reveal class="format" delay={i * 70}>
            <div class="format-icon" aria-hidden="true">{
              f.icon === "shirt" ? "🥋" :
              f.icon === "video" ? "▶" :
              f.icon === "star" ? "★" : "↗"
            }</div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <Reveal>
        <h2>Tu veux collaborer ?</h2>
        <p>Demande le media kit et discutons d'un format adapté à ta marque.</p>
        <a href="/contact" class="btn">Contacter l'équipe</a>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  .page-header { padding-top: 4rem; padding-bottom: 3rem; }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .lead { color: var(--text-dim); font-size: 1.15rem; max-width: 45rem; margin-top: 1rem; }
  .cta-row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2rem; }

  .audience-section { background: var(--bg-elevated); }
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.25rem;
    margin: 2.5rem 0 1.5rem;
  }
  .audience-card {
    padding: 2.2rem 1.25rem 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .audience-value {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--accent);
    line-height: 1;
  }
  .audience-label {
    display: block;
    margin-top: 0.6rem;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .audience-source {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-dim);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .footnote {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-style: italic;
    max-width: 50rem;
  }
  .quote-section { background: var(--bg); }
  .formats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .format {
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .format:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .format-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }
  .format h3 { margin-bottom: 0.75rem; }
  .format p { color: var(--text-dim); }
  .cta-section {
    background:
      radial-gradient(ellipse at center, rgba(220, 38, 38, 0.16), transparent 70%),
      var(--bg);
    text-align: center;
  }
  .cta-inner h2 { margin-bottom: 1rem; }
  .cta-inner p { color: var(--text-dim); margin-bottom: 2rem; }
</style>
