---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";

// TODO Paul : remplacer les champs ENTRE CROCHETS avant la mise en prod.
const editor = {
  name: "[Paul Denis Navero]",
  status: "[Statut : auto-entrepreneur / EI / SASU / etc.]",
  siret: "[Numéro SIRET]",
  address: "[Adresse complète de l'entreprise]",
  email: "contact@pauldena.fr",
  director: "Paul Denis Navero",
};

const host = {
  name: "[Nom de l'hébergeur — Vercel Inc. / Cloudflare Inc. / OVH / Netlify]",
  address: "[Adresse de l'hébergeur]",
  phone: "[Téléphone de l'hébergeur]",
};
---

<Base title={`Mentions légales — ${profile.nickname}`}>
  <section class="page-header section">
    <div class="container">
      <span class="eyebrow">Informations</span>
      <h1>Mentions légales</h1>
      <p class="lead">Dernière mise à jour : {new Date().toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}.</p>
    </div>
  </section>

  <section class="section legal">
    <div class="container">
      <h2>1. Éditeur du site</h2>
      <p>
        Le site <strong>pauldena.fr</strong> est édité par {editor.name},
        {editor.status}.<br />
        SIRET : {editor.siret}<br />
        Adresse : {editor.address}<br />
        Email : <a href={`mailto:${editor.email}`}>{editor.email}</a><br />
        Directeur de la publication : {editor.director}.
      </p>

      <h2>2. Hébergeur</h2>
      <p>
        {host.name}<br />
        {host.address}<br />
        {host.phone}
      </p>

      <h2>3. Propriété intellectuelle</h2>
      <p>
        L'ensemble des éléments du site (textes, images, vidéos, logos, charte graphique)
        est protégé par le droit d'auteur. Toute reproduction, représentation, modification
        ou exploitation, totale ou partielle, sans autorisation écrite préalable de
        {" "}{editor.director} est strictement interdite.
      </p>
      <p>
        Les marques et logos partenaires éventuellement présents restent la propriété de
        leurs détenteurs respectifs.
      </p>

      <h2>4. Crédits photo & vidéo</h2>
      <p>
        Photos issues des comptes officiels @pauldenisnavero ainsi que des productions
        partenaires (Hexagone MMA, équipementiers). Les droits d'image relatifs aux
        adversaires lors des combats relèvent des organisations concernées.
      </p>

      <h2>5. Liens externes</h2>
      <p>
        Le site contient des liens vers des plateformes tierces (Instagram, TikTok,
        YouTube, X). L'éditeur n'exerce aucun contrôle sur leur contenu et décline toute
        responsabilité quant à leur exploitation.
      </p>

      <h2>6. Loi applicable</h2>
      <p>
        Le site est soumis au droit français. Tout litige relève de la compétence des
        tribunaux français.
      </p>

      <h2>7. Contact</h2>
      <p>
        Pour toute question relative aux présentes mentions :
        {" "}<a href={`mailto:${editor.email}`}>{editor.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-header { padding-top: 4rem; padding-bottom: 2rem; }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.15em;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .lead { color: var(--text-dim); margin-top: 1rem; }
  .legal h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.4rem;
  }
  .legal h2:first-child { margin-top: 0; }
  .legal p {
    color: var(--text-dim);
    margin-bottom: 1rem;
    max-width: 50rem;
    line-height: 1.7;
  }
  .legal a { color: var(--accent); }
</style>
