---
import Base from "../layouts/Base.astro";
import Reveal from "../components/Reveal.astro";
import { profile, record } from "../data/profile";

const timeline = [
  {
    year: "2019",
    title: "Premières vidéos YouTube & TikTok",
    body: "Inspiré par le biopic Notorious sur Conor McGregor, Paul lance ses chaînes à 17 ans et documente son parcours vers le haut niveau. La caméra devient un outil de discipline autant qu'un canal de partage.",
  },
  {
    year: "2022",
    title: "Émergence — Your Fight Club (YFC)",
    body: "Premières exposition nationale via les events YFC diffusés sur la chaîne IbraTV. Le format mix combat amateur + storytelling propulse une nouvelle génération de combattants français.",
  },
  {
    year: "2023",
    title: "Champion de France Amateur",
    body: "Titre national amateur dans sa catégorie. Confirmation que la base technique (judo ceinture noire, lutte, frappes) tient la route face à l'élite hexagonale.",
  },
  {
    year: "2024",
    title: "Médaille de bronze IMMAF Europe",
    body: "Podium continental aux Championnats d'Europe amateurs IMMAF, jalon majeur avant le passage pro.",
  },
  {
    year: "2024",
    title: "Record du KO le plus rapide — Hexagone MMA",
    body: "14 septembre à Colmar : KO sur Alex Andrews en 5 secondes. Plus court finish de l'histoire d'Hexagone MMA. Buzz médiatique national, couverture RMC Sport.",
  },
  {
    year: "2025",
    title: "Passage pro — 3 victoires, 3 KO/TKO",
    body: "Débuts professionnels à l'Arkéa Arena de Bordeaux (mai), suivis de deux victoires au Zénith Paris-La Villette (sept., janv. 2026). 100% de finish.",
  },
  {
    year: "2026",
    title: "Reconnaissance & nouvelle ambition",
    body: "Communauté > 800K cumulés (IG + YT + TT). Commentateur invité UFC Paris. Main event prévu au LDLC Arena de Lyon le 12 juin face à Anzor Baybatyrov.",
  },
];

const facts = [
  { label: "Né en", value: profile.birthYear.toString() },
  { label: "Origine", value: "Rennes — basé à Colmar" },
  { label: "Catégorie", value: profile.weightClass ?? "—" },
  { label: "Taille", value: profile.height ?? "—" },
  { label: "Garde", value: profile.stance ?? "—" },
  { label: "Disciplines", value: profile.disciplines.join(", ") },
  { label: "Équipe", value: profile.team ?? "—" },
  { label: "Record pro", value: `${record.pro.w}-${record.pro.l}-${record.pro.d} (${record.pro.finishRate})` },
];
---

<Base
  title={`Parcours — ${profile.nickname}`}
  description="Du judo à l'élite MMA : le parcours de Paul Dena, combattant pro né en 2002, champion de France amateur, médaillé européen IMMAF, record du KO le plus rapide d'Hexagone MMA."
>
  <section class="page-header section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Parcours</span>
        <h1>De Rennes à la scène pro</h1>
        <p class="lead">
          Paul Denis Navero, né en {profile.birthYear}. Combattant MMA professionnel,
          créateur de contenu, entrepreneur. Du judo en club au main event d'Hexagone MMA.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container bio-grid">
      <Reveal class="bio-text">
        <h2>Qui est Paul Dena</h2>
        <p>
          Paul démarre par le judo et y décroche la ceinture noire. C'est là qu'il forge
          sa première identité : un grappler explosif, à l'aise dans le contact et la
          projection. À l'adolescence, il bascule vers la boxe puis le MMA, persuadé que
          la polyvalence est le seul vrai avantage compétitif à l'ère moderne.
        </p>
        <p>
          Sa singularité : il documente tout. Chaque camp, chaque blessure, chaque doute
          se retrouve sur YouTube. Là où d'autres construisent une carrière en silence,
          il bâtit en transparence. Ce choix lui vaut une audience qui dépasse aujourd'hui
          les 800&nbsp;000 abonnés cumulés et une notoriété rare pour un combattant aussi
          jeune.
        </p>
        <p>
          Côté ring, il enchaîne trois victoires pro par KO ou TKO en moins d'un an,
          dont une au Zénith Paris-La Villette devant 7&nbsp;000 spectateurs. Son record
          du KO en 5 secondes contre Alex Andrews à Colmar reste à ce jour la finition la
          plus rapide jamais enregistrée par Hexagone MMA.
        </p>
        <p>
          Ce qui le motive : prouver qu'on peut allier le sérieux d'un athlète de haut
          niveau et la liberté d'un entrepreneur. Pas le combattant qui crée du contenu,
          pas le créateur qui combat : les deux, à fond, en même temps.
        </p>
      </Reveal>
      <Reveal class="bio-facts" delay={150}>
        <h3>En bref</h3>
        <dl>
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </Reveal>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="container">
      <Reveal><h2>Étapes clés</h2></Reveal>
      <ol class="timeline">
        {
          timeline.map((step, i) => (
            <Reveal as="li" delay={i * 60}>
              <span class="t-year">{step.year}</span>
              <div class="t-content">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section honors-section">
    <div class="container">
      <h2>Titres & distinctions</h2>
      <ul class="honors">
        <li><span>2024</span><strong>Record Hexagone MMA</strong> — KO le plus rapide de l'histoire (5 s, vs Alex Andrews, Colmar).</li>
        <li><span>2024</span><strong>Bronze IMMAF Europe</strong> — Championnats d'Europe MMA amateur.</li>
        <li><span>2023</span><strong>Champion de France amateur</strong> — Catégorie bantamweight.</li>
        <li><span>—</span><strong>Ceinture noire de judo</strong> — Base grappling.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-header { padding-top: 4rem; padding-bottom: 3rem; }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.15em;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .lead {
    color: var(--text-dim);
    font-size: 1.15rem;
    max-width: 45rem;
    margin-top: 1rem;
  }
  .bio-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 800px) {
    .bio-grid { grid-template-columns: 1fr; }
  }
  .bio-text p { margin-bottom: 1rem; color: var(--text-dim); line-height: 1.7; }
  .bio-text h2 { margin-bottom: 1.5rem; }
  .bio-facts {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    align-self: start;
    position: sticky;
    top: 88px;
  }
  .bio-facts h3 { margin-bottom: 1rem; }
  .bio-facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .bio-facts dl div:last-child { border-bottom: none; }
  .bio-facts dt { color: var(--text-dim); font-size: 0.9rem; }
  .bio-facts dd { font-weight: 600; text-align: right; }

  .timeline-section { background: var(--bg-elevated); }
  .timeline { list-style: none; margin-top: 3rem; padding-left: 0; }
  .timeline li {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .timeline li:last-child { border-bottom: none; }
  .t-year {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--accent);
    line-height: 1;
  }
  .t-content h3 { margin-bottom: 0.5rem; }
  .t-content p { color: var(--text-dim); line-height: 1.7; }

  .honors { list-style: none; margin-top: 2rem; padding-left: 0; display: flex; flex-direction: column; gap: 1rem; }
  .honors li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .honors span {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.1rem;
  }
  .honors strong { font-weight: 700; }
</style>
