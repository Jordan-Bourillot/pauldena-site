---
import Base from "../layouts/Base.astro";
import VideoCard from "../components/VideoCard.astro";
import Reveal from "../components/Reveal.astro";
import { profile } from "../data/profile";

const YT_CHANNEL_ID = "UCJMvCyy_DqvyedtQOJm4tvQ";
const RSS_URL = `https://www.youtube.com/feeds/videos.xml?channel_id=${YT_CHANNEL_ID}`;

type Video = {
  title: string;
  url: string;
  thumbnail?: string;
  source: "YouTube" | "TikTok" | "Instagram";
  date?: string;
  publishedAt?: number;
};

const decode = (s: string) =>
  s.replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#39;/g, "'");

async function fetchYouTube(): Promise<Video[]> {
  try {
    const res = await fetch(RSS_URL, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!res.ok) return [];
    const xml = await res.text();
    const entries = xml.split("<entry>").slice(1);
    return entries.map((e) => {
      const id = e.match(/<yt:videoId>([^<]+)<\/yt:videoId>/)?.[1] ?? "";
      const title = decode(e.match(/<title>([^<]+)<\/title>/)?.[1] ?? "");
      const published = e.match(/<published>([^<]+)<\/published>/)?.[1] ?? "";
      const ts = published ? Date.parse(published) : 0;
      return {
        id,
        title,
        url: `https://www.youtube.com/watch?v=${id}`,
        thumbnail: id ? `https://i.ytimg.com/vi/${id}/maxresdefault.jpg` : undefined,
        source: "YouTube" as const,
        date: published ? new Date(published).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" }) : undefined,
        publishedAt: ts,
      };
    }).filter((v) => v.url);
  } catch {
    return [];
  }
}

const fallback: Video[] = [
  { title: "Tibo Inshape me défie en boxe anglaise", url: "https://www.youtube.com/watch?v=oYPRxi5UZn0", thumbnail: "https://i.ytimg.com/vi/oYPRxi5UZn0/maxresdefault.jpg", source: "YouTube", date: "5 avr. 2026" },
  { title: "J'inflige le plus GROS KO de ma CARRIÈRE", url: "https://www.youtube.com/watch?v=Kxo_SQ9onaU", thumbnail: "https://i.ytimg.com/vi/Kxo_SQ9onaU/maxresdefault.jpg", source: "YouTube", date: "17 janv. 2026" },
  { title: "Je découvre la 1ère école de trading de France", url: "https://www.youtube.com/watch?v=suD0cWVqnqI", thumbnail: "https://i.ytimg.com/vi/suD0cWVqnqI/maxresdefault.jpg", source: "YouTube", date: "15 mars 2026" },
  { title: "Je suis commentateur à l'UFC PARIS !", url: "https://www.youtube.com/watch?v=D4FFS_2KDHQ", thumbnail: "https://i.ytimg.com/vi/D4FFS_2KDHQ/maxresdefault.jpg", source: "YouTube", date: "3 oct. 2025" },
  { title: "KO pour mon 2ème combat Pro de MMA", url: "https://www.youtube.com/watch?v=fiLjXxBhT5U", thumbnail: "https://i.ytimg.com/vi/fiLjXxBhT5U/maxresdefault.jpg", source: "YouTube", date: "26 sept. 2025" },
  { title: "À la POURSUITE de l'EXCELLENCE (Épisode 1)", url: "https://www.youtube.com/watch?v=sTPvXttvzfw", thumbnail: "https://i.ytimg.com/vi/sTPvXttvzfw/maxresdefault.jpg", source: "YouTube", date: "31 août 2025" },
];

const yt = await fetchYouTube();
const all = (yt.length > 0 ? yt : fallback)
  .sort((a, b) => (b.publishedAt ?? 0) - (a.publishedAt ?? 0))
  .slice(0, 13);

const featured = all[0];
const others = all.slice(1);

const filters = ["Tout", "YouTube", "TikTok", "Instagram"];
const usingFallback = yt.length === 0;
---

<Base
  title={`Vidéos — ${profile.nickname}`}
  description="Les dernières vidéos de la chaîne YouTube officielle de Paul Dena. Vlogs, combats, training, behind-the-scenes — mis à jour à chaque build."
>
  <section class="page-header section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Médias</span>
        <h1>Vidéos & moments forts</h1>
        <p class="lead">
          Les dernières vidéos publiées sur la chaîne YouTube officielle, mises à jour
          à chaque build.
        </p>
      </Reveal>
    </div>
  </section>

  {featured && (
    <section class="section featured-section">
      <div class="container">
        <Reveal>
          <a href={featured.url} target="_blank" rel="noopener noreferrer" class="featured">
            <div class="featured-thumb" style={`background-image: url(${featured.thumbnail})`} aria-hidden="true"></div>
            <div class="featured-body">
              <span class="featured-badge">{featured.source} · dernière</span>
              <h2>{featured.title}</h2>
              {featured.date && <time>{featured.date}</time>}
              <span class="featured-cta">Regarder ↗</span>
            </div>
          </a>
        </Reveal>
      </div>
    </section>
  )}

  <section class="section videos-section">
    <div class="container">
      <Reveal>
        <div class="filters">
          {filters.map((f, i) => (
            <button class:list={["filter-btn", { active: i === 0 }]} data-filter={f}>
              {f}
            </button>
          ))}
        </div>
      </Reveal>
      <div class="videos-grid">
        {others.map((v, i) => (
          <Reveal delay={i * 50}>
            <VideoCard {...v} />
          </Reveal>
        ))}
      </div>
      {usingFallback && (
        <p class="footnote">Liste de secours affichée (RSS YouTube non joignable au build).</p>
      )}
    </div>
  </section>
</Base>

<style>
  .page-header { padding-top: 4rem; padding-bottom: 2rem; }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    color: var(--accent);
    letter-spacing: 0.22em;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .lead { color: var(--text-dim); font-size: 1.15rem; max-width: 40rem; margin-top: 1rem; }

  .featured-section { padding-top: 0; padding-bottom: 3rem; }
  .featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: stretch;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .featured:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
    color: var(--text);
  }
  .featured-thumb {
    aspect-ratio: 16 / 9;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-elevated);
  }
  .featured-body { padding: 2rem; display: flex; flex-direction: column; justify-content: center; gap: 0.6rem; }
  .featured-badge {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    background: rgba(220, 38, 38, 0.14);
    color: var(--accent);
    border-radius: 999px;
    font-size: 0.75rem;
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    width: fit-content;
  }
  .featured-body h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.1; }
  .featured-body time { color: var(--text-dim); font-size: 0.9rem; }
  .featured-cta { color: var(--accent); font-weight: 600; margin-top: 0.5rem; }
  @media (max-width: 800px) { .featured { grid-template-columns: 1fr; } }

  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 0.55rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: all 0.15s ease;
    font-family: var(--font-body);
  }
  .filter-btn:hover { color: var(--text); border-color: var(--border-strong); }
  .filter-btn.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .footnote {
    margin-top: 2rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".videos-grid > *");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const f = btn.dataset.filter;
      cards.forEach((c) => {
        const badge = c.querySelector(".source-badge")?.textContent?.trim();
        const show = f === "Tout" || badge === f;
        c.style.display = show ? "" : "none";
      });
    });
  });
</script>
