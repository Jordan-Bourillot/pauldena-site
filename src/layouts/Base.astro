---
import SideNav from "../components/SideNav.astro";
import Footer from "../components/Footer.astro";
import TriskellSignoff from "../components/TriskellSignoff.astro";
import TriskellBadge from "../components/TriskellBadge.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { profile, record, fights, upcomingFights } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  noJsonLd?: boolean;
}

const {
  title = `${profile.name} — ${profile.tagline}`,
  description = `${profile.name} (${profile.nickname}), ${profile.tagline}`,
  noJsonLd = false,
} = Astro.props;

const ogImage = new URL("/og.jpg", Astro.site ?? "https://pauldena.fr").toString();
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://pauldena.fr").toString();

// JSON-LD Person schema — utile pour Google Knowledge Panel / résultats riches
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.nickname,
  birthDate: `${profile.birthYear}`,
  description: profile.tagline,
  url: "https://pauldena.fr",
  image: ogImage,
  jobTitle: "Professional MMA fighter",
  worksFor: { "@type": "SportsOrganization", name: profile.team ?? "Hexagone MMA" },
  athlete: {
    "@type": "Person",
    name: profile.name,
    sport: "Mixed Martial Arts",
  },
  homeLocation: { "@type": "Place", name: profile.city },
  sameAs: [
    "https://www.instagram.com/pauldenisnavero/",
    "https://www.youtube.com/@pauldenisnavero",
    "https://www.tiktok.com/@pauldenisnavero",
    "https://x.com/pauldenismma",
  ],
};
const jsonLdString = JSON.stringify(jsonLd);
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dim' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${profile.name} — portrait`} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {!noJsonLd && <script type="application/ld+json" set:html={jsonLdString} />}
    <ClientRouter />
  </head>
  <body class="sidebar-layout">
    <SideNav />
    <main class="sidebar-main">
      <slot />
    </main>
    <TriskellSignoff />
    <Footer />
    <TriskellBadge />
  </body>
</html>
